# terraform apply genera .env automáticamente. NUNCA subas .env a git.
DB_HOST=<rds_endpoint>
DB_PORT=5432
DB_NAME=concertpass
DB_USER=postgres
DB_PASSWORD=<tu-password>
DB_SSLMODE=require
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account_id>/concertpass-reservations.fifo
DYNAMODB_TABLE=concertpass-events
